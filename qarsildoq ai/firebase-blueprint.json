{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Authenticated user profile and synchronized application settings for qarsildoq.ai.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Firebase Auth user ID."
        },
        "displayName": {
          "type": "string",
          "maxLength": 120,
          "description": "User display name."
        },
        "email": {
          "type": "string",
          "maxLength": 200,
          "description": "Verified user email address."
        },
        "photoURL": {
          "type": "string",
          "maxLength": 500,
          "description": "Profile avatar URL."
        },
        "theme": {
          "type": "string",
          "enum": ["dark", "light"],
          "maxLength": 10,
          "description": "Preferred UI color theme."
        },
        "voiceName": {
          "type": "string",
          "enum": ["Puck", "Charon", "Kore", "Fenrir", "Zephyr"],
          "maxLength": 20,
          "description": "Selected Gemini TTS voice persona."
        },
        "autoSpeak": {
          "type": "boolean",
          "description": "Whether assistant responses are automatically spoken aloud."
        },
        "model": {
          "type": "string",
          "enum": ["gemini-4-hydrogen", "gemini-3.1-flash-lite"],
          "maxLength": 40,
          "description": "Selected Gemini conversation model."
        },
        "searchGrounding": {
          "type": "boolean",
          "description": "Whether Google Search grounding is enabled for answers."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server last-update timestamp."
        }
      },
      "required": [
        "uid",
        "theme",
        "voiceName",
        "autoSpeak",
        "model",
        "searchGrounding",
        "createdAt",
        "updatedAt"
      ]
    },
    "Conversation": {
      "title": "Conversation",
      "description": "A chat conversation thread belonging to a user.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Conversation document ID."
        },
        "ownerId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Owner user UID."
        },
        "title": {
          "type": "string",
          "maxLength": 160,
          "description": "Conversation title."
        },
        "lastMessagePreview": {
          "type": "string",
          "maxLength": 300,
          "description": "Short preview of the latest message."
        },
        "messageCount": {
          "type": "integer",
          "description": "Total number of messages in the conversation."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server last-update timestamp."
        }
      },
      "required": [
        "id",
        "ownerId",
        "title",
        "lastMessagePreview",
        "messageCount",
        "createdAt",
        "updatedAt"
      ]
    },
    "ChatMessage": {
      "title": "ChatMessage",
      "description": "Individual user or assistant message within a conversation.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Message document ID."
        },
        "ownerId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Owner user UID."
        },
        "conversationId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Parent conversation ID."
        },
        "role": {
          "type": "string",
          "enum": ["user", "assistant"],
          "maxLength": 20,
          "description": "Sender role."
        },
        "text": {
          "type": "string",
          "maxLength": 20000,
          "description": "Message body text."
        },
        "funFact": {
          "type": "string",
          "maxLength": 1000,
          "description": "Optional highlighted curiosity note."
        },
        "sources": {
          "type": "array",
          "description": "Up to 10 verified grounding web source links."
        },
        "model": {
          "type": "string",
          "maxLength": 40,
          "description": "Model identifier used for the response."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        }
      },
      "required": [
        "id",
        "ownerId",
        "conversationId",
        "role",
        "text",
        "createdAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Private user profile and synced preferences document."
    },
    "/users/{userId}/conversations/{conversationId}": {
      "schema": { "$ref": "#/entities/Conversation" },
      "description": "User-owned chat threads."
    },
    "/users/{userId}/conversations/{conversationId}/messages/{messageId}": {
      "schema": { "$ref": "#/entities/ChatMessage" },
      "description": "Messages belonging to a specific user conversation."
    }
  }
}
